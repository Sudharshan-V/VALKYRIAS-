# Frontend-safe Supabase settings. Only VITE_* variables are bundled into the
# browser. Never put the service-role key in a VITE_* variable.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
DEV_API_PROXY_TARGET="http://localhost:8080"

# Backend Supabase settings. SUPABASE_SERVICE_ROLE_KEY is secret and must be
# supplied only to the Spring Boot process or deployment secret manager.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_PROFILE_BUCKET="profile-avatars"
PROFILE_AVATAR_MAX_BYTES="5242880"
SUPABASE_SIGNED_URL_TTL_SECONDS="3600"

# Supabase PostgreSQL connection used by Spring Boot. Use the direct/session
# pooler JDBC URL appropriate for the deployment and require TLS in production.
SPRING_DATASOURCE_URL="jdbc:postgresql://your-database-host:5432/postgres?sslmode=require"
SPRING_DATASOURCE_USERNAME="your-database-user"
SPRING_DATASOURCE_PASSWORD="your-database-password"
SPRING_JPA_HIBERNATE_DDL_AUTO="validate"
SPRING_JPA_SHOW_SQL="false"
SPRING_H2_CONSOLE_ENABLED="false"

# Multipart limits should be at least the avatar limit while still bounding the
# total request. Keep these aligned with PROFILE_AVATAR_MAX_BYTES.
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE="5MB"
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE="6MB"

# Comma-separated browser origins accepted by the Spring API.
APP_ALLOWED_ORIGINS="http://localhost:3000"

# Optional legacy demo-account seeding. Keep disabled outside explicit local
# development and provide the password only to the backend process.
APP_SEED_USERS_ENABLED="false"
APP_SEED_PASSWORD=""
